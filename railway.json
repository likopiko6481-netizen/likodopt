{
  "$schema": "https://railway.app",
  "build": {
    "builder": "NIXPACKS",
    "config": {
      "environment": {
        "ENABLE_WEBSOCKETS": "true",
        "NODE_ENV": "production"
      }
    }
  },
  "deploy": {
    "startCommand": "node server.js",
    "startTimeout": 180,
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
